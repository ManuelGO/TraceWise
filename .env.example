# PostgreSQL Configuration
POSTGRES_USER=tracewise
POSTGRES_PASSWORD=<your_dev_password>
POSTGRES_DB=tracewise

# Redis Configuration
# Connection URL format: redis://[password@]host:port[/database]
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=<your_redis_password>

# Backend Database URL
# Note: Password must match POSTGRES_PASSWORD above
DATABASE_URL=postgresql://tracewise:<your_dev_password>@postgres:5432/tracewise
