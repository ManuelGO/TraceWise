# ============================================================================
# Application Environment
# ============================================================================
# One of: development, test, production
ENVIRONMENT=development

# ============================================================================
# API Configuration
# ============================================================================
# API title for documentation
API_TITLE=TraceWise API

# API version
API_VERSION=0.1.0

# API bind address (0.0.0.0 for all interfaces, 127.0.0.1 for localhost)
API_HOST=0.0.0.0

# API port (must be between 1024 and 65535)
API_PORT=8000

# ============================================================================
# PostgreSQL Configuration
# ============================================================================
# PostgreSQL username
POSTGRES_USER=tracewise

# PostgreSQL password
POSTGRES_PASSWORD=dev_password

# PostgreSQL database name
POSTGRES_DB=tracewise

# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database
# For development: postgresql://tracewise:dev_password@postgres:5432/tracewise
# For local testing: postgresql://postgres:postgres@localhost:5432/tracewise
DATABASE_URL=postgresql://tracewise:dev_password@postgres:5432/tracewise

# ============================================================================
# Redis Configuration
# ============================================================================
# Redis connection URL
# Format: redis://[:password@]host:port
# For development with password: redis://:dev_redis_password@redis:6379
# For development without password: redis://redis:6379
REDIS_URL=redis://:dev_redis_password@redis:6379

# Redis password (included in REDIS_URL above, kept for backward compatibility)
REDIS_PASSWORD=dev_redis_password

# ============================================================================
# Celery Configuration
# ============================================================================
# Celery broker URL (auto-built from REDIS_URL + REDIS_PASSWORD)
# If REDIS_PASSWORD is set, the broker URL will automatically include authentication
# No need to set these manually unless REDIS_URL doesn't include the password
# CELERY_BROKER_URL=redis://:dev_redis_password@redis:6379/0

# Celery backend URL (auto-built from REDIS_URL + REDIS_PASSWORD)
# CELERY_BACKEND_URL=redis://:dev_redis_password@redis:6379/1

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Development: DEBUG for verbose output
# Production: WARNING to reduce noise
LOG_LEVEL=INFO

# ============================================================================
# CORS Configuration
# ============================================================================
# Comma-separated list of allowed origins for CORS
# Development: http://localhost:4200
# Production: https://yourdomain.com
CORS_ORIGINS=http://localhost:4200

# ============================================================================
# Database Connection Pool Settings (Optional)
# ============================================================================
# Size of connection pool (default: 10)
# DB_POOL_SIZE=10

# Maximum overflow size for connection pool (default: 20)
# DB_MAX_OVERFLOW=20

# Enable connection health check before using from pool (default: true)
# DB_POOL_PRE_PING=true

# Echo SQL statements to logs (default: false, set to true for debugging)
# DB_ECHO=false

# ============================================================================
# Application Performance Settings (Optional)
# ============================================================================
# Number of worker processes (default: 4)
# WORKERS=4

# Request timeout in seconds (default: 60)
# TIMEOUT=60
