# PostgreSQL Configuration
POSTGRES_USER=tracewise
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=tracewise
DATABASE_URL=postgresql://tracewise:dev_password@postgres:5432/tracewise

# Redis Configuration (password must be included in URL)
REDIS_PASSWORD=dev_redis_password
REDIS_URL=redis://:dev_redis_password@redis:6379

# Application Environment
ENVIRONMENT=development

# CORS Configuration
CORS_ORIGINS=http://localhost:4200

# Database Connection Pool Settings (Optional)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_PRE_PING=true
# DB_ECHO=false
